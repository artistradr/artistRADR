# Copy this file to .env.migration (same folder) and fill in real values.
# .env.migration should NEVER be committed — it holds the service-role key.

# Your live WordPress site (no trailing slash)
WP_BASE_URL=https://artistradr.com

# Supabase project — from Project Settings > API
# Reuse the same VITE_SUPABASE_URL value from your app's .env
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# SERVICE ROLE key — NOT the anon/publishable key. This bypasses RLS so the
# script can write posts and upload storage objects. This key must only
# ever live here, on your local machine, for this one-off script. Never put
# it in the app's .env, never commit it, never ship it client-side.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJqaXZrZW1ham90YWZqdnRhbG9sIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzA4NjA5MSwiZXhwIjoyMTAyNjYyMDkxfQ.fkj7njM8ERqhEokboiMwCRN5vXTlWTTe4VQlSPtg72Y

# Storage bucket for post covers + rehosted inline images (already exists
